                "status": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "vm_id": {
                    "type": "string"
                }
            }
        },
        "agent.VM": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "disk_path": {
                    "type": "string"
                },
                "firecracker_pid": {
                    "type": "integer"
                },
                "gateway_ip": {
                    "type": "string"
                },
                "guest_ip": {
                    "type": "string"
                },
                "guest_mac": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "kernel_path": {
                    "type": "string"
                },
                "memory_mib": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "netmask": {
                    "type": "string"
                },
                "rootfs_path": {
                    "type": "string"
                },
                "state": {

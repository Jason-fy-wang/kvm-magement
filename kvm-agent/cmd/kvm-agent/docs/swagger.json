{
    "swagger": "2.0",
    "info": {
        "description": "This is a KVM Agent server.",
        "title": "Swagger API for KVM Agent",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support"
        },
        "license": {
